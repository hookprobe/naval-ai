"""`r_stem`: the gene that made a houseboat expressible, and its no-op floor.

MOTIVATING INCIDENT (2026-08-23, docs/research/HOUSEBOAT-16M.md and the I13
session record). A non-expert asked for a 16 m x 4 m houseboat, got a hull he
described as "a spearhead", and was right: the delivered boat carried 4 m of
beam over 22% of its length and reached 61% of a rectangle's deck area. It was
not a tuning failure — no slider could fix it — and the surface never said so.

THREE INDEPENDENT BOUNDS EACH FORBADE A BARGE, and all three had to move:

  1. `sac_ordinate` ended its forward branch at a HARDCODED a(L) = 0 while the
     aft branch ended at `r_transom`. `_stations` SOLVES the chine
     half-breadth from the sectional area, so an area forced to zero forces
     the BEAM to zero: every hull came to a point forward. -> `r_stem`.
  2. `r_transom` was capped at 0.50, so the stern section could never exceed
     half the midship area. Measured best transom beam: 1.96 m of 4.00 m.
     -> ceiling 0.92.
  3. `Cp` was capped at 0.710 (the span of `PRISMATIC_BY_FROUDE`). The full
     ends a barge needs reach Cp 0.831 AT THE LOWEST, so the kernel refused
     with "sac: Cp 0.7100 unreachable at x_mb 0.550, r_transom 0.920" — naming
     a Cp the designer had not chosen. -> ceiling 0.95.

MEASURED on a 16.0 x 4.0 m liveaboard at 14 t, before and after:

                       % length at >=90% beam    deck area      stern    bow
    before                     39%               43.6 m2 (68%)  1.96 m  0.00 m
    after                      88%               59.4 m2 (93%)  4.22 m  1.50 m

The cost is real and is paid in drag, not hidden: 7 kn went from 9.0 kW to
12.3 kW, still inside the 15 kW installed, top speed 7.78 -> 7.50 kn.
"""

from __future__ import annotations

import numpy as np
import pytest

from navalai import grammar, limits
from navalai.geometry import GeometryError, Hull
from navalai.reference import REFERENCE_HULL


def test_the_stem_gene_floor_is_a_no_op():
    """r_stem = 0 must reproduce the pointed bow BIT FOR BIT.

    This is the clause that makes appending a gene safe: every genome written
    before `r_stem` existed still describes exactly the hull it always did.
    """
    x16 = np.array([REFERENCE_HULL[n] for n in grammar.NAMES[:16]], float)
    x17 = grammar.vector(dict(REFERENCE_HULL, r_stem=0.0))
    a, b = Hull(x16), Hull(x17)
    for attr in ("y_sheer", "z_sheer", "y_chine", "z_chine", "z_keel",
                 "y_wl", "A_sac"):
        assert np.array_equal(getattr(a, attr), getattr(b, attr)), attr
    assert a.form_coefficients() == b.form_coefficients()


def test_r_stem_is_appended_so_existing_indices_are_unchanged():
    """A new gene must not renumber the old ones."""
    assert grammar.NAMES[-1] == "r_stem"
    assert grammar.NAMES[:16] == [
        "LWL", "BWL", "T", "D", "Cp", "lcb", "x_mb", "r_transom", "beta_mid",
        "beta_bow", "beta_len", "roundness", "rocker", "forefoot", "flare",
        "sheer_rise"]


def test_a_genome_may_omit_r_stem_but_not_a_real_gene():
    """The narrow allowance, and that it stays narrow."""
    assert grammar.POST_HOC_DEFAULTS == {"r_stem": 0.0}
    v = grammar.vector(dict(REFERENCE_HULL))          # no r_stem
    assert v[grammar.NAMES.index("r_stem")] == 0.0
    with pytest.raises(KeyError):
        grammar.vector({k: v for k, v in REFERENCE_HULL.items() if k != "LWL"})


def test_an_unknown_gene_is_refused_rather_than_discarded():
    """MEASURED 2026-08-23: `vector` silently dropped unknown keys.

    When the E5 recalibration removed `l_pmb`, every caller still passing it
    went on running and quietly got a different hull. It produced a false
    measurement — three `l_pmb` settings reported as "giving identical beam",
    when in truth none of them was ever applied. A missing key raised while an
    unknown key vanished.
    """
    with pytest.raises(KeyError, match="l_pmb"):
        grammar.vector(dict(REFERENCE_HULL, l_pmb=0.7))


def test_the_barge_bounds_are_open_far_enough_to_draw_a_box():
    """The three ceilings, pinned so none of them silently returns."""
    hi = dict((p[0], p[3]) for p in grammar.PARAMS)
    assert hi["r_transom"] >= 0.9, "a full transom is unreachable again"
    assert hi["r_stem"] >= 0.8, "a pram bow is unreachable again"
    assert limits.CP_GENE_BOUNDS[1] >= 0.9, (
        "the Cp ceiling is back below what a box's SAC reaches (0.831 at the "
        "lowest), so the kernel will refuse a barge by naming a Cp nobody "
        "chose")


def test_a_sixteen_by_four_houseboat_carries_its_beam():
    """THE BAR, and it is the user-visible one: a houseboat is a rectangle.

    Bars are set BELOW the measured values (88% and 59.4 m2) so that ordinary
    kernel drift does not fail the suite, but far above the pre-fix state
    (39% and 43.6 m2) so a regression to a spearhead does.
    """
    g = dict(REFERENCE_HULL, LWL=15.2, BWL=4.0, T=0.391, D=1.55,
             r_stem=0.40, r_transom=0.92, Cp=0.92, lcb=-1.5, x_mb=0.50,
             beta_mid=8.0, beta_bow=10.0, beta_len=0.45, roundness=0.0,
             rocker=0.05, forefoot=0.10, flare=6.0, sheer_rise=0.12)
    x = grammar.vector(g)
    rep = grammar.check(x)
    assert rep.ok, [str(v) for v in rep.violations]

    hull = Hull(x)
    beam = 2.0 * hull.y_sheer
    carried = float((beam >= 0.90 * 4.0).mean())
    deck = hull.deck_area()
    assert carried >= 0.75, (
        f"only {100 * carried:.0f}% of the waterline carries full beam "
        f"(pre-fix was 39%, post-fix 88%) — the spearhead is back")
    assert deck >= 55.0, (
        f"deck area {deck:.1f} m2 against 64.0 m2 for a 16x4 rectangle "
        f"(pre-fix 43.6, post-fix 59.4)")
    assert beam[0] >= 3.5, f"transom beam {beam[0]:.2f} m — the stern is pinched"


def test_the_pointed_bow_is_still_reachable():
    """Opening the box must not close the old corner of it."""
    g = dict(REFERENCE_HULL, r_stem=0.0)
    hull = Hull(grammar.vector(g))
    assert 2.0 * hull.y_sheer[-1] == pytest.approx(0.0, abs=1e-9)


def test_a_stem_fullness_the_cp_gene_cannot_feed_is_refused_by_name():
    """The kernel must still REFUSE an unreachable target, not approximate it."""
    g = dict(REFERENCE_HULL, r_transom=0.92, r_stem=0.70, Cp=0.60)
    with pytest.raises(GeometryError, match="Cp"):
        Hull(grammar.vector(g))
