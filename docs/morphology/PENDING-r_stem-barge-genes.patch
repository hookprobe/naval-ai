+# Genes a caller may OMIT, and the value that leaves the geometry unchanged.
+#
+# This is a narrow allowance, not a defaults table. `r_stem` was appended on
+# 2026-08-23 and its floor 0.0 reproduces the pointed bow this kernel drew
+# before it existed, bit for bit — so every genome dict written before that
+# date still describes exactly the hull it always did. Without this, adding a
+# gene silently breaks every literal genome in the tree (MEASURED: it broke
+# `formcheck._vec` and with it `certify`, on import).
+#
+# A gene belongs here ONLY if some value of it is provably a no-op. Anything
+# else must be supplied, because a default that CHANGES the hull is a hull
+# nobody chose.
+POST_HOC_DEFAULTS: dict[str, float] = {"r_stem": 0.0}
+
+
 def vector(d: dict[str, float]) -> np.ndarray:
-    return np.array([d[n] for n in NAMES], dtype=float)
+    """A genome vector from a name -> value mapping.
+
+    A MISSING gene raises, EXCEPT the ones in `POST_HOC_DEFAULTS`. An UNKNOWN
+    key also raises, and that clause is not decoration: until 2026-08-23 this
+    function silently DISCARDED any key it did not recognise, so when the E5
+    recalibration removed `l_pmb` every caller still passing it went on
+    running and quietly got a different hull. It produced at least one false
+    measurement — three `l_pmb` settings "giving identical beam", when in
+    truth not one of them was ever applied. A missing key raised while an
+    unknown key vanished; both are now errors.
+    """
+    missing = [n for n in NAMES if n not in d and n not in POST_HOC_DEFAULTS]
+    if missing:
+        raise KeyError(
+            f"genome is missing {missing}; it has {sorted(d)}. Only "
+            f"{sorted(POST_HOC_DEFAULTS)} may be omitted, and only because "
+            f"their default leaves the geometry unchanged.")
+    unknown = [k for k in d if k not in NAMES]
+    if unknown:
+        raise KeyError(
+            f"genome carries {unknown}, which {'is' if len(unknown) == 1 else 'are'} "
+            f"not {'a gene' if len(unknown) == 1 else 'genes'} in this grammar. "
+            f"Known genes: {NAMES}. (Silently dropping these is how a removed "
+            f"gene went on being 'set' for hours after it stopped existing.)")
+    return np.array([d.get(n, POST_HOC_DEFAULTS.get(n, 0.0)) for n in NAMES],
+                    dtype=float)
