+#: `BWL` is a mistake and still raises; a dict missing `l_pmb` was written
+#: before `l_pmb` existed, and `l_pmb = 0` collapses the parallel middle body
+#: to zero length (`geometry.pmb_span` returns x1 = x2 = x_mb*L), so the hull
+#: it describes is the same hull it always described. Every entry here has to
+#: carry that identity property, and a gene whose zero is NOT the identity
+#: does not belong in this mapping.
+POST_HOC_DEFAULTS = {"l_pmb": 0.0}
