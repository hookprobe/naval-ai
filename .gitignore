__pycache__/
*.pyc
data/*.sqlite3
.venv/
runs/
.DS_Store
downloads/

# Benchmark geometry is NOT redistributed (workshop terms), but its record is.
# Gap J5: with the whole directory ignored, the KCS "-0.09% on displacement"
# validation silently skipped on every machine but the one that generated the
# file, and nothing in the repo said what the missing file should have been.
# The pattern must be `dir/*`, not `dir/`: git will not re-include a path
# inside a directory it has already excluded.
data/benchmark_geom/*
!data/benchmark_geom/CHECKSUMS.json

# BUILD ARTIFACTS, gap J6. `data/exports/hull.{iges,step}` are REGENERATED by
# the test suite on every run, so tracking them dirtied the tree constantly —
# they were re-modified by 5 of the last 10 commits, caused cherry-pick
# conflicts, and provoked an unasked `git checkout --` by another agent.
# `renders/` held 9 committed PNGs (~2.3 MB) of CFD output that is reproducible
# from the runs.
data/exports/
renders/

badFaces
illegalFaces
selfInterPoints.obj
*.obj
